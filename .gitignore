/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

### VS Code ###
.vscode/
!.vscode/extensions.json

# ── Sistema operacional ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Logs e temporários ───────────────────────────────────────────────────
*.log
logs/
*.tmp
*.bak
*.swp
*~

# ── Docker ───────────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml

# ── Exceções ─────────────────────────────────────────────────────────────
# Modelo das variáveis de ambiente, sem segredo algum: precisa ser versionado
# para que outra pessoa consiga subir o projeto.
!.env.example
