# ── Modelo de variáveis de ambiente ─────────────────────────────────────────
# Copie para .env e ajuste:  cp .env.example .env
# O .env está no .gitignore e nunca vai para o repositório. Este arquivo é a
# exceção deliberada: documenta as variáveis sem conter valor sensível algum.
#
# Os valores abaixo são de desenvolvimento local e não são credenciais reais.

# ── Portas do host ──────────────────────────────────────────────────────────
# O TP2 usa um bloco próprio (15432 · 18080 · 13000) em vez das usuais
# 5432/8080/3000. Motivo: as portas padrão são as primeiras a serem disputadas
# por outros projetos na máquina, e as etapas do projeto integrado (TP1…TP5)
# podem precisar rodar ao mesmo tempo. Dentro da rede do Docker os serviços
# seguem conversando pelas portas internas de sempre.
DB_PORT=15432
BACKEND_PORT=18080
FRONTEND_PORT=13000

# ── Banco de dados — PostgreSQL 18 (perfis dev e prod) ──────────────────────
DB_NAME=infnethub
DB_USER=infnethub
DB_PASS=infnethub

# Sobrescreve a URL inteira, se preciso (tem precedência sobre DB_PORT):
# DB_URL=jdbc:postgresql://localhost:15432/infnethub

# Tamanho do pool de conexões (apenas perfil prod; padrão 20)
# DB_POOL_SIZE=20

# ── Aplicação ───────────────────────────────────────────────────────────────
# Porta HTTP do back-end quando executado fora do Docker (./mvnw spring-boot:run)
SERVER_PORT=18080

# Origens liberadas no CORS (separadas por vírgula). Em produção não é localhost.
CORS_ORIGINS=http://localhost:13000

# ── Perfil ativo ────────────────────────────────────────────────────────────
# dev  - PostgreSQL via Docker Compose (padrão)
# prod - PostgreSQL a partir das variáveis DB_* acima, todas obrigatórias
#
# Em produção não há valor padrão para DB_URL/DB_USER/DB_PASS: a aplicação não
# sobe sem elas, de propósito, para que nenhum default silencioso acabe virando
# credencial de produção.
SPRING_PROFILES_ACTIVE=dev

# ── Front-end (Next.js) ─────────────────────────────────────────────────────
# Copiado em frontend/.env.local
NEXT_PUBLIC_API_URL=http://localhost:18080/api/v1
